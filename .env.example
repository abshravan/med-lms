# Root environment for Docker Compose.
#
# Copy to `.env` before running `docker compose up`. Compose reads this file
# automatically and injects the values into the service definitions.
#
# The backend and web workspaces each have their own `.env.example` for running
# them outside Docker.
#
# NEVER commit a real `.env`. It is git-ignored.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=medlms
# Required — compose refuses to start without it. Generate: openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=med_lms
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
NODE_ENV=development
DEBUG=true
# `development` for hot reload, `production` for the lean non-root images.
BUILD_TARGET=development

API_PORT=8000
WEB_PORT=3000

# ── Identity ─────────────────────────────────────────────────────────────────
# Required. Signs session cookies; must be at least 32 characters and identical
# across every web replica. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the web app. Becomes the JWT `iss` claim, which the API verifies.
BETTER_AUTH_URL=http://localhost:3000

# JWT `aud` claim, shared by both services. They must agree exactly.
AUTH_AUDIENCE=med-lms-api

# ── Frontend (inlined into the browser bundle — never a secret) ───────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend ──────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API. Never "*".
CORS_ORIGINS=http://localhost:3000

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_FROM=no-reply@medlms.local
# Unset in development: emails are printed to the web container's logs.
RESEND_API_KEY=
