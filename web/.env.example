# Web environment contract.
#
# Copy to `.env.local` for local development. Validated by src/lib/env.ts at
# startup — a missing or malformed value fails the boot with a listed reason
# rather than producing a confusing runtime error.
#
# NEVER commit a real `.env.local`. It is git-ignored.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Better Auth owns the `auth` schema in this database; Alembic owns `public`.
# Same value as the backend's DATABASE_URL.
DATABASE_URL=postgresql://medlms:changeme@localhost:5432/med_lms

# ── Better Auth ──────────────────────────────────────────────────────────────
# Signs session cookies. MUST be identical across every web replica, or users are
# randomly signed out as requests land on different instances.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# Public base URL of this app. Becomes the JWT `iss` claim, so it must exactly
# equal AUTH_ISSUER on the backend.
BETTER_AUTH_URL=http://localhost:3000

# JWT `aud` claim. Must exactly equal AUTH_AUDIENCE on the backend, or the API
# rejects every token with "not issued for this API".
AUTH_AUDIENCE=med-lms-api

# Extra origins allowed to call the auth endpoints (CSRF origin check).
# Comma-separated. BETTER_AUTH_URL is always trusted and need not be listed.
# TRUSTED_ORIGINS=https://app.medlms.com,medlms://

# ── Domain API ───────────────────────────────────────────────────────────────
# Server-to-server URL. Inside Docker Compose this is the service name.
API_INTERNAL_URL=http://localhost:8000

# ── Public (inlined into the browser bundle — never put a secret here) ────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_FROM=no-reply@medlms.local
# Leave unset in development: verification and reset emails are then printed to
# the console, so the whole flow works with no third-party account.
# RESEND_API_KEY=re_xxxxxxxxxxxx
