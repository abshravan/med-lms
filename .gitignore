node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.turbo/
coverage/
.vitest/

# ── Tooling ──────────────────────────────────────────────────────────────────
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/settings.json
