# ── Secrets ──────────────────────────────────────────────────────────────────
# Only `.env.example` files are tracked. A real `.env` must never be committed.
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

