# Backend environment contract.
#
# Copy to `.env` for local development outside Docker. Every variable without a
# default is required — the application refuses to boot without it rather than
# falling back to something insecure.
#
# NEVER commit a real `.env`. It is git-ignored.

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | test | staging | production
DEBUG=true
# Interactive docs are disabled automatically when ENVIRONMENT=production.

# ── Datastores ───────────────────────────────────────────────────────────────
# The plain postgresql:// form is shared with Better Auth and Alembic; the async
# driver prefix is applied in code so there is one URL for the whole stack.
DATABASE_URL=postgresql://medlms:changeme@localhost:5432/med_lms
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0

# ── Identity bridge ──────────────────────────────────────────────────────────
# Where to fetch Better Auth's public signing keys. Inside Docker Compose this is
# the service name; locally it is localhost.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Expected `iss` claim — must exactly equal BETTER_AUTH_URL in the web workspace.
AUTH_ISSUER=http://localhost:3000

# Expected `aud` claim. Must match AUTH_AUDIENCE in the web workspace, otherwise
# every token is rejected as "not issued for this API".
AUTH_AUDIENCE=med-lms-api

AUTH_JWKS_CACHE_TTL_SECONDS=600
AUTH_LEEWAY_SECONDS=10

# ── Media storage ────────────────────────────────────────────────────────────
# `local` writes to the API container's disk — development only. Settings refuses
# it when ENVIRONMENT=production, because media would be lost on restart.
STORAGE_BACKEND=local
MEDIA_LOCAL_ROOT=/tmp/med-lms-media
# Public URL of this API. Used to build signed URLs for the local backend.
MEDIA_PUBLIC_BASE_URL=http://localhost:8000

# Cloudflare R2 (or any S3-compatible service). Required when STORAGE_BACKEND=s3.
# S3_BUCKET=med-lms-media
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# How long an upload link stays valid. Long enough for a slow connection to
# start a large file, short enough that a leaked URL is not a standing grant.
MEDIA_UPLOAD_URL_TTL_SECONDS=900
# Playback links are re-issued per view, so this stays short.
MEDIA_PLAYBACK_URL_TTL_SECONDS=300

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated. The browser calls this API directly, so the web origin must be
# listed. Never use "*" — credentials are sent on these requests.
CORS_ORIGINS=http://localhost:3000

# ── Testing ──────────────────────────────────────────────────────────────────
# Used only by the test suite. Must be a database you are happy to have dropped.
TEST_DATABASE_URL=postgresql://medlms:changeme@localhost:5432/med_lms_test
